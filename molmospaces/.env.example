# Optional: instead of passing --llm-base-url / --llm-api-key-file to batbatbat-serve, copy this to .env,
# fill it locally, then: set -a; source .env; set +a
# An HTTPS base URL that serves POST /responses (include its version prefix, e.g. .../v1).
BATBATBAT_LLM_BASE_URL=
BATBATBAT_LLM_API_KEY=
# Optional deployment alias, ONLY when it serves the same model.
BATBATBAT_LLM_MODEL=
